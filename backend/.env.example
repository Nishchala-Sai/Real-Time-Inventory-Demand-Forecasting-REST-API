NODE_ENV=development
PORT=4000
# Must be a replica set, because stock changes use transactions. docker compose provides one.
MONGODB_URI=mongodb://localhost:27017/inventory?directConnection=true
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-32+-random-chars-access
JWT_REFRESH_SECRET=change-me-to-32+-random-chars-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
APP_ORIGIN=http://localhost:5173
# Optional comma-separated list of extra allowed browser origins.
CORS_ORIGINS=
# Set to 1 behind one proxy (Render, Fly and similar).
TRUST_PROXY=0
# IANA zone that decides where one sales day ends.
STORE_TZ=UTC
SSE_MAX_CLIENTS=500
LOG_LEVEL=info
# Used only by the seed script.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
