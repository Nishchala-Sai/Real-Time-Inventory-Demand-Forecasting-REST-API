{
  "name": "inventory-forecasting",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "npm run seed -w backend",
    "rebuild": "npm run rebuild -w backend",
    "docs:lint": "redocly lint docs/openapi.yaml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.76.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "vitest": "^5.1.0"
  }
}
